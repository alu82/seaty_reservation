<.header>
  Allocation for <%= @event.code %>
  <:actions>
    <.link href={~p"/events"}>
      <.button>Back to Events</.button>
    </.link>
  </:actions>
</.header>

<div class="min-h-screen p-0 mt-4">

  <!-- Rows 1-4: 24 seats each -->
  <div class="grid grid-cols-4 gap-1 mb-8">
    <%= for row <- 1..4 do %>
      <.row row_number={row} seat_count={24} assigned={Enum.filter(@result.assigned, &(&1.row == row))} />
    <% end %>
  </div>

  <!-- Rows 5-9: 19 seats each -->
  <div class="grid grid-cols-5 gap-1 mb-8">
    <%= for row <- 5..9 do %>
      <.row row_number={row} seat_count={19} assigned={Enum.filter(@result.assigned, &(&1.row == row))} />
    <% end %>
  </div>

  <!-- Rows 10-13: 4 seats each -->
  <div class="grid grid-cols-4 gap-1 mb-8">
    <%= for row <- 10..13 do %>
      <.row row_number={row} seat_count={4} assigned={Enum.filter(@result.assigned, &(&1.row == row))} />
    <% end %>
  </div>

  <h2 class="text-2xl font-bold text-slate-800 mb-4">Not Allocated</h2>
  
  <%= if @result.unallocated != [] do %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= for entry <- @result.unallocated do %>
        <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 shadow-sm">
          <div class="text-sm font-semibold text-amber-800">
            Reservation: <%= entry.code %>
          </div>
          <div class="text-sm text-amber-700">
            Group: <%= entry.group || "None" %>
          </div>
          <div class="text-sm text-amber-700">
            Seats: <%= entry.seats %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<.header>
  Listing Users
  <:actions>
    <.link navigate={~p"/users/new"}>
      <.button>New User</.button>
    </.link>
  </:actions>
</.header>

<.table id="users" rows={@users} row_click={&JS.navigate(~p"/users/#{&1}")}>
  <:col :let={user} label="Email"><%= user.email %></:col>
  <:col :let={user} label="Role"><%= user.role %></:col>
  <:col :let={user} label="Confirmed"><%= if user.confirmed_at, do: "Yes", else: "No" %></:col>
  <:action :let={user}>
    <.link navigate={~p"/users/#{user}/edit"}>Edit</.link>
  </:action>
  <:action :let={user}>
    <.link
      href={~p"/users/#{user}"}
      method="delete"
      data-confirm="Delete this user? This cannot be undone."
    >
      Delete
    </.link>
  </:action>
</.table>

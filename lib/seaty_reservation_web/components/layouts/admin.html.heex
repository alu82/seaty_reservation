<header class="px-4 sm:px-6 lg:px-8 bg-[#1b4048]">
  <div class="flex items-center justify-between text-sm">

    <!-- Logo -->
    <div class="flex items-center">
      <a href={~p"/"}>
        <img src={~p"/images/logo.png"} width="170" />
      </a>
    </div>

    <!-- Desktop navigation -->
    <nav class="hidden md:flex items-center gap-6 text-white text-base tracking-wide">
      <a href={~p"/productions"} class="hover:text-gray-300 transition-colors">
        Productions
      </a>

      <a href={~p"/events"} class="hover:text-gray-300 transition-colors">
        Events
      </a>

      <a href={~p"/reservations"} class="hover:text-gray-300 transition-colors">
        Reservations
      </a>
    </nav>

    <!-- Mobile navigation -->
    <details class="md:hidden relative">
      <summary class="cursor-pointer text-white text-2xl list-none">
        ☰
      </summary>

      <nav class="absolute right-0 mt-4 w-48 bg-[#1b4048] rounded-lg shadow-lg p-4 flex flex-col gap-4 text-white text-base tracking-wide">
        <a href={~p"/productions"} class="hover:text-gray-300 transition-colors">
          Productions
        </a>

        <a href={~p"/events"} class="hover:text-gray-300 transition-colors">
          Events
        </a>

        <a href={~p"/reservations"} class="hover:text-gray-300 transition-colors">
          Reservations
        </a>
      </nav>
    </details>

  </div>
</header>

<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
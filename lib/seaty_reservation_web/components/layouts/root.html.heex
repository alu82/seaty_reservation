<!DOCTYPE html>
<html lang="de" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>
      <%= assigns[:page_title] || "SeatyReservation" %>
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} sizes="any" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} sizes="180x180" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-white antialiased">
    <%= if @current_user do %>
      <ul class="relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
        <li class="hidden md:block">
          <.link
            href={~p"/productions"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Productions
          </.link>
        </li>
        <li class="hidden md:block">
          <.link
            href={~p"/events"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Events
          </.link>
        </li>
        <li class="hidden md:block">
          <.link
            href={~p"/reservations"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Reservations
          </.link>
        </li>
        <li class="hidden md:block">
          <.link
            href={~p"/users/settings"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Settings
          </.link>
        </li>
        <li class="hidden md:block">
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Logout
          </.link>
        </li>

        <details class="md:hidden relative">
          <summary class="cursor-pointer text-zinc-900 text-2xl list-none">
            ☰
          </summary>
          <nav class="absolute right-0 mt-4 w-48 bg-white rounded-lg shadow-lg p-4">
            <ul class="flex flex-col gap-4 text-zinc-900 text-base">
              <li>
                <.link
                  href={~p"/productions"}
                  class="hover:text-zinc-700"
                >
                  Productions
                </.link>
              </li>
              <li>
                <.link
                  href={~p"/events"}
                  class="hover:text-zinc-700"
                >
                  Events
                </.link>
              </li>
              <li>
                <.link
                  href={~p"/reservations"}
                  class="hover:text-zinc-700"
                >
                  Reservations
                </.link>
              </li>
              <li>
                <.link
                  href={~p"/users/settings"}
                  class="hover:text-zinc-700"
                >
                  Settings
                </.link>
              </li>
              <li>
                <.link
                  href={~p"/users/log_out"}
                  method="delete"
                  class="hover:text-zinc-700"
                >
                  Logout
                </.link>
              </li>
            </ul>
          </nav>
        </details>
      </ul>
    <% end %>
    <%= @inner_content %>
  </body>
</html>
